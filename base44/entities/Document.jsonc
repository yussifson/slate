{
  "name": "Document",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_type": {
      "type": "string"
    },
    "file_size": {
      "type": "number",
      "description": "Size in bytes"
    },
    "case_id": {
      "type": "string"
    },
    "case_title": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "court_filing",
        "pleading",
        "court_order",
        "evidence",
        "contract",
        "correspondence",
        "scanned_document",
        "id_document",
        "invoice",
        "other"
      ],
      "default": "other"
    },
    "filing_date": {
      "type": "string",
      "format": "date",
      "description": "Date the document was filed in court"
    },
    "uploaded_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "shared_with_client": {
      "type": "boolean",
      "default": false,
      "description": "Whether this document is visible in the client portal"
    }
  },
  "required": [
    "name",
    "company_id"
  ]
}