{
  "name": "Expense",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "case_title": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "travel",
        "filing_fees",
        "court_costs",
        "postage",
        "printing",
        "accommodation",
        "expert_fees",
        "translation",
        "other"
      ],
      "default": "other"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "GHS",
        "NGN",
        "SLL",
        "USD"
      ],
      "default": "GHS"
    },
    "expense_date": {
      "type": "string",
      "format": "date"
    },
    "receipt_url": {
      "type": "string"
    },
    "logged_by": {
      "type": "string"
    },
    "logged_by_name": {
      "type": "string"
    },
    "billable": {
      "type": "boolean",
      "default": true
    },
    "billed": {
      "type": "boolean",
      "default": false
    },
    "invoice_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "billed"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "description",
    "amount",
    "company_id",
    "case_id"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.company_id}}"
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}"
        },
        {
          "data.logged_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}",
          "$or": [
            {
              "data.logged_by": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "company_admin"
              }
            },
            {
              "user_condition": {
                "role": "finance"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}",
          "$or": [
            {
              "data.logged_by": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "company_admin"
              }
            },
            {
              "user_condition": {
                "role": "finance"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}