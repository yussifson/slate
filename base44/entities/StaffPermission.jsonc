      "default": false
    },
    "can_edit_cases": {
      "type": "boolean",
      "default": false
    },
    "can_delete_cases": {
      "type": "boolean",
      "default": false
    },
    "can_view_clients": {
      "type": "boolean",
      "default": true
    },
    "can_create_clients": {
      "type": "boolean",
      "default": false
    },
    "can_edit_clients": {
      "type": "boolean",
      "default": false
    },
    "can_delete_clients": {
      "type": "boolean",
      "default": false
    },
    "can_view_invoices": {
      "type": "boolean",
      "default": false
    },
    "can_create_invoices": {
      "type": "boolean",
      "default": false
    },
    "can_view_documents": {
      "type": "boolean",
      "default": true
    },
    "can_upload_documents": {
      "type": "boolean",
      "default": true
    },
    "can_delete_documents": {
      "type": "boolean",
