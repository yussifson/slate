{
  "name": "CaseOutcome",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "case_title": {
      "type": "string"
    },
    "case_type": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "assigned_lawyer": {
      "type": "string"
    },
    "assigned_lawyer_name": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "won",
        "lost",
        "settled",
        "dismissed",
        "withdrawn",
        "ongoing"
      ],
      "default": "ongoing"
    },
    "outcome_date": {
      "type": "string",
      "format": "date"
    },
    "outcome_summary": {
      "type": "string"
    },
    "settlement_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "GHS",
        "NGN",
        "SLL",
        "USD"
      ],
      "default": "GHS"
    },
    "duration_days": {
      "type": "number"
    },
    "court_name": {
      "type": "string"
    },
    "judge_name": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "case_id",
    "outcome"
  ]
}