{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "case_title": {
      "type": "string"
    },
    "case_number": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "lawyer_email": {
      "type": "string"
    },
    "lawyer_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "description": "ISO timestamp when timer started"
    },
    "end_time": {
      "type": "string",
      "description": "ISO timestamp when timer stopped"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Total duration in minutes"
    },
    "hourly_rate": {
      "type": "number",
      "description": "Rate per hour for billing"
    },
    "billable_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "GHS",
        "NGN",
        "SLL",
        "USD"
      ],
      "default": "GHS"
    },
    "is_billable": {
      "type": "boolean",
      "default": true
    },
    "billed": {
      "type": "boolean",
      "default": false,
      "description": "Has been included in an invoice"
    },
    "invoice_id": {
      "type": "string",
      "description": "Invoice this was compiled into"
    },
    "category": {
      "type": "string",
      "enum": [
        "legal_research",
        "court_appearance",
        "client_meeting",
        "document_drafting",
        "correspondence",
        "consultation",
        "other"
      ],
      "default": "other"
    }
  },
  "required": [
    "case_id",
    "company_id",
    "lawyer_email"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.company_id}}"
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}"
        },
        {
          "data.lawyer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}",
          "$or": [
            {
              "data.lawyer_email": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "company_admin"
              }
            },
            {
              "user_condition": {
                "role": "finance"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}",
          "$or": [
            {
              "data.lawyer_email": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "company_admin"
              }
            },
            {
              "user_condition": {
                "role": "finance"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}