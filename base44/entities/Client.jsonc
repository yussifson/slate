{
  "name": "Client",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Tenant company ID"
    },
    "type": {
      "type": "string",
      "enum": [
        "individual",
        "organization"
      ],
      "default": "individual"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "id_number": {
      "type": "string",
      "description": "National ID or company registration"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "lead"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    },
    "total_cases": {
      "type": "number",
      "default": 0
    },
    "total_billed": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "company_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "company_admin"
              }
            },
            {
              "user_condition": {
                "role": "lawyer"
              }
            },
            {
              "user_condition": {
                "role": "paralegal"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "company_admin"
              }
            },
            {
              "user_condition": {
                "role": "lawyer"
              }
            },
            {
              "user_condition": {
                "role": "paralegal"
              }
            }
          ]
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}",
          "$or": [
            {
              "user_condition": {
                "role": "company_admin"
              }
            },
            {
              "user_condition": {
                "role": "lawyer"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}