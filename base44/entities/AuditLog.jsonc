{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "description": "e.g. created, updated, deleted, viewed, signed"
    },
    "entity_type": {
      "type": "string",
      "description": "e.g. LegalCase, Invoice, Document"
    },
    "entity_id": {
      "type": "string"
    },
    "entity_label": {
      "type": "string",
      "description": "Human-readable label of the entity"
    },
    "details": {
      "type": "string",
      "description": "Extra context about what changed"
    },
    "ip_address": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    }
  },
  "required": [
    "company_id",
    "user_email",
    "action",
    "entity_type"
  ]
}