{
  "name": "PayrollSlip",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "staff_email": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "staff_role": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "pay_period": {
      "type": "string",
      "description": "e.g. 2026-05"
    },
    "basic_salary": {
      "type": "number"
    },
    "allowances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "deductions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "gross_salary": {
      "type": "number"
    },
    "total_deductions": {
      "type": "number"
    },
    "net_salary": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "GHS",
        "NGN",
        "SLL",
        "USD"
      ],
      "default": "GHS"
    },
    "leave_days_taken": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "paid"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "paid_at": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "staff_email",
    "pay_period",
    "basic_salary",
    "net_salary"
  ]
}