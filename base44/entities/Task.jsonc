{
  "name": "Task",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "case_title": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of assignee"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "enum": [
        "legal",
        "admin",
        "finance",
        "hr",
        "other"
      ],
      "default": "legal"
    }
  },
  "required": [
    "title",
    "company_id"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.company_id}}"
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}",
          "$or": [
            {
              "data.assigned_to": "{{user.email}}"
            },
            {
              "created_by": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "company_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.company_id}}",
          "$or": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "company_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}