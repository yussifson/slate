{
  "name": "ClientChecklist",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "case_title": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string"
    },
    "assigned_by_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "waived"
      ],
      "default": "pending"
    },
    "completed_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "document_id": {
      "type": "string",
      "description": "Linked document if client uploaded one"
    }
  },
  "required": [
    "company_id",
    "client_id",
    "title"
  ]
}